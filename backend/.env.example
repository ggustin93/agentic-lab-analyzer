# Required — AI services
MISTRAL_API_KEY=your_mistral_api_key_here
CHUTES_AI_API_KEY=your_chutes_api_key_here

# Persistence (ADR-008): "local" (default — SQLite + local folder, no cloud
# account needed) or "supabase"
STORAGE_MODE=local

# Local mode (defaults shown)
# DB_PATH=data/app.db
# UPLOAD_DIR=uploads
# PUBLIC_BASE_URL=http://localhost:8000

# Supabase mode only
# SUPABASE_URL=your_supabase_url_here
# SUPABASE_KEY=your_supabase_key_here
# SUPABASE_BUCKET_NAME=health-docs

# Optional
# CHUTES_AI_MODEL=chutesai/Mistral-Small-3.2-24B-Instruct-2506
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MAX_FILE_SIZE=10485760
# CORS_ORIGINS=["http://localhost:4200"]
